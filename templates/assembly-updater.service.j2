[Unit]
Description=Update UCSC Genome Browser genome assemblies
Wants=network-online.target
After=network-online.target mariadb.service

[Service]
Type=oneshot
ExecStart=/usr/bin/flock /run/lock/ucsc-genome-browser-update.lock /usr/bin/env {{ ucsc_genome_browser_assemblies_env | default('') }} {{ ucsc_genome_browser_setup_script_path }} -b -u mirror {{ ucsc_genome_browser_assemblies_update_assemblies | join(' ') }}
# `mirror` always switches to offline mode
ExecStartPost={{ ucsc_genome_browser_setup_script_path }} -b {{ 'offline' if ucsc_genome_browser_offline_mode else 'online' }}
